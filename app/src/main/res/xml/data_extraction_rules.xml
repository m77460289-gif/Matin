<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not restore an in-progress timer on a different device. -->
        <exclude domain="sharedpref" path="timer_state.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Keep timer runtime state local during device-to-device migration too. -->
        <exclude domain="sharedpref" path="timer_state.xml" />
    </device-transfer>
</data-extraction-rules>
